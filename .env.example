# Database backend selection: "local" (default) or "turso"
DB_MODE=local

# Local SQLite database path (used when DB_MODE=local)
DB_PATH=./data/vocleap.db

# Turso (libsql) database URL (used when DB_MODE=turso)
TURSO_URL=libsql://your-database-your-org.turso.io

# Turso authentication token (used when DB_MODE=turso)
TURSO_AUTH_TOKEN=xxx

# First account with this email claims all pre-multi-user words.
# Set this before deploying and sign up first.
OWNER_EMAIL=you@example.com

# CI environment flag (Playwright)
CI=
