{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "types": [
      "node"
    ],
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    ".next-test/types/**/*.ts",
    ".next-test/dev/types/**/*.ts",
    ".next-final/types/**/*.ts",
    ".next-final/dev/types/**/*.ts",
    ".next-check/types/**/*.ts",
    ".next-check/dev/types/**/*.ts",
    ".next-pwa/types/**/*.ts",
    ".next-pwa/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "lib/srs/fsrs.test.ts",
    "lib/timezone.test.ts",
    "lib/srs/sm2.test.ts"
  ]
}
