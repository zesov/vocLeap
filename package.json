{
  "name": "vocleap",
  "version": "0.10.0",
  "private": true,
  "description": "Open-source vocabulary learning PWA — dictionary lookup, spaced repetition (SM-2/FSRS), cross-device sync",
  "license": "MIT",
  "author": "Gavin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zesov/vocLeap.git"
  },
  "scripts": {
    "dev": "NODE_USE_ENV_PROXY=1 next dev",
    "build": "NODE_USE_ENV_PROXY=1 next build",
    "start": "NODE_USE_ENV_PROXY=1 next start",
    "lint": "eslint",
    "copy-wasm": "bun scripts/copy-wasm.ts",
    "predev": "bun run copy-wasm",
    "prebuild": "bun run copy-wasm",
    "migrate": "NODE_USE_ENV_PROXY=1 node --env-file-if-exists=.env scripts/migrate.ts",
    "migrate:multiuser": "NODE_USE_ENV_PROXY=1 node --env-file-if-exists=.env scripts/migrate-multiuser.ts",
    "claim-owner": "NODE_USE_ENV_PROXY=1 node --env-file-if-exists=.env scripts/claim-owner.ts",
    "backfill:phonetic": "NODE_USE_ENV_PROXY=1 node --env-file-if-exists=.env scripts/backfill-phonetic.ts",
    "backfill:uuid": "NODE_USE_ENV_PROXY=1 node --env-file-if-exists=.env scripts/backfill-uuid.ts",
    "reset:unreviewed": "NODE_USE_ENV_PROXY=1 node --env-file-if-exists=.env scripts/reset-unreviewed-reviews.ts",
    "release": "bun --env-file-if-exists=.env scripts/release.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@sqlite.org/sqlite-wasm": "^3.54.1-build1",
    "@vercel/analytics": "^2.0.1",
    "anylang": "^4.0.0",
    "better-sqlite3": "^13.0.3",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "ts-fsrs": "^6.0.0",
    "wa-sqlite": "^1.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@serwist/turbopack": "^9.5.13",
    "@tailwindcss/turbopack": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "serwist": "^9.5.13",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
