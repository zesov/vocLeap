{
  "name": "vocleap",
  "version": "0.7.1",
  "private": true,
  "description": "Open-source vocabulary learning PWA — dictionary lookup, spaced repetition (SM-2/FSRS), cross-device sync",
  "license": "MIT",
  "author": "Gavin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zesov/vocLeap.git"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "migrate": "node --env-file-if-exists=.env scripts/migrate.ts",
    "migrate:multiuser": "node --env-file-if-exists=.env scripts/migrate-multiuser.ts",
    "claim-owner": "node --env-file-if-exists=.env scripts/claim-owner.ts",
    "backfill:phonetic": "node --env-file-if-exists=.env scripts/backfill-phonetic.ts",
    "backfill:uuid": "node --env-file-if-exists=.env scripts/backfill-uuid.ts",
    "reset:unreviewed": "node --env-file-if-exists=.env scripts/reset-unreviewed-reviews.ts",
    "release": "bun --env-file-if-exists=.env scripts/release.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@vercel/analytics": "^2.0.1",
    "anylang": "^4.0.0",
    "better-sqlite3": "^13.0.3",
    "next": "16.4.3",
    "next-pwa": "^5.6.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "ts-fsrs": "^6.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
